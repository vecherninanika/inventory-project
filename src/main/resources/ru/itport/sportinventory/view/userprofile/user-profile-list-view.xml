<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://userProfileListView.title"
      focusComponent="userProfilesDataGrid">
    <data>
        <collection id="userProfilesDc"
                    class="ru.itport.sportinventory.entity.UserProfile">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="userProfilesDl" readOnly="true">
                <query>
                    <![CDATA[select e from UserProfile e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="userProfilesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="userProfilesDataGrid.create"/>
            <button id="editButton" action="userProfilesDataGrid.edit"/>
            <button id="removeButton" action="userProfilesDataGrid.remove"/>
            <simplePagination id="pagination" dataLoader="userProfilesDl"/>
        </hbox>
        <dataGrid id="userProfilesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="userProfilesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="create" type="list_create"/>
                <action id="edit" type="list_edit"/>
                <action id="remove" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="user"/>
                <column property="telegramId"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
