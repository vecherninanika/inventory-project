<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://brokenEquipmentReportDetailView.title"
      focusComponent="form">
    <data>
        <instance id="brokenEquipmentReportDc"
                  class="ru.itport.sportinventory.entity.BrokenEquipmentReport">
            <fetchPlan extends="_base">
                <property name="inventory" fetchPlan="_base">
                    <property name="category" fetchPlan="_base"/>
                </property>
                <property name="user" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="brokenEquipmentReportDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="brokenEquipmentReportDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <entityPicker id="inventoryField" property="inventory">
                <actions>
                    <action id="entityLookup" type="entity_lookup"/>
                    <action id="entityClear" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="userField" property="user">
                <actions>
                    <action id="entityLookup" type="entity_lookup"/>
                    <action id="entityClear" type="entity_clear"/>
                </actions>
            </entityPicker>
            <textArea id="descriptionField" height="9.5em" property="description"/>
            <fileStorageUploadField id="photoField" clearButtonVisible="true" fileNameVisible="true" property="photo"/>
            <select id="statusField" property="status"/>
            <dateTimePicker id="createdDateField" property="createdDate"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
